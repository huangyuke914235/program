{
  "name": "relayforge",
  "version": "2.0.0",
  "private": true,
  "description": "A Spring Boot webhook delivery platform with a React dashboard and Vue receiver demo.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "mvn -f java/pom.xml spring-boot:run",
    "dev:web": "vite --host 127.0.0.1",
    "dev:receiver": "npm --prefix receiver-ui run dev",
    "build:web": "tsc -p tsconfig.web.json --noEmit && vite build",
    "build:receiver": "npm --prefix receiver-ui run build",
    "build:java": "mvn -B -ntp -f java/pom.xml package",
    "build": "npm run build:web && npm run build:receiver && npm run build:java",
    "start": "java -jar java/target/relayforge-2.0.0.jar",
    "setup": "node scripts/setup.mjs",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:web && npm --prefix receiver-ui run typecheck",
    "test": "mvn -B -ntp -f java/pom.xml test",
    "check": "npm test && npm run build:web && npm run build:receiver",
    "dev:legacy": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build:legacy": "tsc -p tsconfig.server.json && vite build",
    "start:legacy": "node --env-file-if-exists=.env dist/server/index.js",
    "worker:legacy": "node --env-file-if-exists=.env --import tsx server/worker-cli.ts",
    "typecheck:legacy": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:legacy": "tsx --test tests/*.test.ts",
    "check:legacy": "npm run typecheck:legacy && npm run test:legacy && npm run build:legacy"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
