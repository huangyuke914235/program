# Prefer `npm run setup`: it creates .env with a random token and enables a local demo.
# This template is for manual configuration. Replace the value below before starting.
API_TOKEN=replace-this-with-a-random-token-of-at-least-32-characters
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/relayforge.sqlite
# Keep false for an externally accessible installation.
DEMO_MODE=false
WORKER_ENABLED=true
RETRY_BASE_MS=1000
